<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Outbound SSH connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The tunnel must survive the UI being backgrounded, so it runs in a
         foreground service. Android 15 caps `dataSync` foreground services at
         6 hours per day, which would silently kill a long-lived tunnel, so this
         app declares `specialUse` instead and explains itself via the property
         below (required for Play review). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SshRelayApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SshRelay"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SshRelay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TunnelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ssh_port_forwarding" />
        </service>

        <!-- Notification "stop" action. A receiver rather than a service intent:
             background apps may not start services, but they may receive broadcasts. -->
        <receiver
            android:name=".service.TunnelActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.sshrelay.action.STOP_TUNNEL" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
