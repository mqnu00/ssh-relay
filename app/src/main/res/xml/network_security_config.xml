<?xml version="1.0" encoding="utf-8"?>
<!--
  The tunnel endpoint is plain HTTP on loopback. Cleartext is denied everywhere
  else, and only re-enabled for the two loopback host names the in-app WebView
  preview uses; the system browser has its own policy and is unaffected.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
