# Local toolchain (JDK / Android SDK / Gradle / AVD) - ~10GB, never commit
.toolchain/

# Python bytecode from scripts/provision.py
__pycache__/
*.pyc

# Build outputs
build/
*/build/
.gradle/
local.properties
*.apk
*.aab

# Verification artifacts (screenshots etc.) - keep dir, ignore contents
artifacts/*
!artifacts/.gitkeep

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
